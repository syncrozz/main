rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Master Admin Helper: strictly locked to master admin emails
    function isMasterAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() in ['khaikerr@gmail.com', 'admin@syncrozz.com', 'chegukay@gmail.com'];
    }

    // Public read & write access for platform OG images and shared configuration documents
    match /platformOgImages/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Public read & write access for custom platforms & configurations
    match /customPlatforms/{platformId} {
      allow read: if true;
      allow write: if true;
    }

    // Public read & write access for custom platform URLs
    match /customPlatformUrls/{urlId} {
      allow read: if true;
      allow write: if true;
    }

    // Public read & write access for platform settings / hidden platforms
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
